---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import SearchModal from '../../components/ui/SearchModal.astro';
import CategoryCard from '../../components/categories/CategoryCard.astro';
import ToolCard from '../../components/tools/ToolCard.astro';
import { allTools } from '../../data/tools/index';
import { categories } from '../../data/categories';
import { getCategoriesWithToolCount } from '../../utils/categories';
import { sample } from '../../utils/random';
import { localePaths } from '../../i18n/paths';
import { getLangFromUrl, useTranslations, useFormatter, getHomeHref } from '../../i18n/utils';
import { organizationJsonLd, websiteJsonLd } from '../../utils/structured-data';

export const getStaticPaths = localePaths;

const base = import.meta.env.BASE_URL;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const tf = useFormatter(lang);
const siteUrl = new URL(base, Astro.site).href;
const homeUrl = new URL(getHomeHref(lang), Astro.site).href;
const jsonLd = [
  organizationJsonLd(siteUrl),
  websiteJsonLd(siteUrl, homeUrl, lang, t('layout.defaultDescription')),
];
const categoriesWithCount = getCategoriesWithToolCount(categories, allTools);
const totalTools = allTools.length;
const totalCategories = categories.length;
const uniqueLicenses = new Set(allTools.map(t => t.license)).size;

// Candidate pools for the "different on every visit" sections. Only these are
// rendered; the inline script below picks VISIBLE_COUNT of them per visit.
// Rendering all 639 tools here cost ~2.3 MB of HTML and ~49k DOM nodes.
const TOOL_POOL = 24;
const CATEGORY_POOL = 18;
const VISIBLE_COUNT = 6;
const toolPool = sample(allTools, TOOL_POOL);
const categoryPool = sample(categoriesWithCount, CATEGORY_POOL);
---

<BaseLayout title={t('page.home.title')} jsonLd={jsonLd}>
  <SearchModal />

  <!-- Hero -->
  <section class="hero-section relative overflow-hidden gradient-bg-hero min-h-screen flex items-center justify-center pt-16" style="isolation: isolate">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <picture class="hero-bg hero-bg-dark absolute inset-0">
        <source media="(max-width: 767px)" type="image/avif" srcset={`${base}hero/mobile-dark.avif`} />
        <source media="(max-width: 767px)" type="image/webp" srcset={`${base}hero/mobile-dark.webp`} />
        <source media="(max-width: 767px)" srcset={`${base}hero/mobile-dark.png`} />
        <source type="image/avif" srcset={`${base}hero/desktop-dark.avif`} />
        <source type="image/webp" srcset={`${base}hero/desktop-dark.webp`} />
        <img src={`${base}hero/desktop-dark.png`} alt="" width="1672" height="941" class="absolute inset-0 w-full h-full object-cover object-center" loading="eager" decoding="async" fetchpriority="high" />
      </picture>
      <video
        class="hero-bg hero-bg-dark-video absolute inset-0 w-full h-full"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={`${base}hero/mobile-dark.webp`}
        aria-hidden="true"
      >
        <source src={`${base}hero/mobile-dark.mp4`} type="video/mp4" />
      </video>
      <picture class="hero-bg hero-bg-light absolute inset-0">
        <source media="(max-width: 767px)" type="image/avif" srcset={`${base}hero/mobile-light.avif`} />
        <source media="(max-width: 767px)" type="image/webp" srcset={`${base}hero/mobile-light.webp`} />
        <source media="(max-width: 767px)" srcset={`${base}hero/mobile-light.png`} />
        <source type="image/avif" srcset={`${base}hero/desktop-light.avif`} />
        <source type="image/webp" srcset={`${base}hero/desktop-light.webp`} />
        <img src={`${base}hero/desktop-light.png`} alt="" width="1920" height="1080" class="absolute inset-0 w-full h-full object-cover object-center" loading="eager" decoding="async" />
      </picture>
    </div>
    <div class="hero-scrim absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="hero-fade-bottom absolute left-0 right-0 bottom-0 pointer-events-none" aria-hidden="true"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm mb-8 animate-fade-in" style="background: var(--color-accent-green-glow); border: 1px solid rgba(34,197,94,0.3); color: var(--color-accent-green-text)">
        <svg class="w-4 h-4 inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 .56-.89l7-4a1 1 0 0 1 .88 0l7 4A1 1 0 0 1 20 6z"/><path d="m9 12 2 2 4-4"/></svg> {t('page.home.badge')}
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight mb-6 animate-fade-in-up" style="color: var(--color-text-primary)">
        {t('page.home.headline')}
        <br />
        <span class="gradient-text">{t('page.home.headlineAccent')}</span>
      </h1>

      <p class="text-lg sm:text-xl max-w-2xl mx-auto mb-10 animate-fade-in-up" style="color: var(--color-text-secondary); animation-delay: 0.1s">
        {tf('page.home.lede', { tools: totalTools })}
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12 animate-fade-in-up" style="animation-delay: 0.2s">
        <a
          href={`${base}${t('nav.href.tools')}`}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-medium no-underline hover:no-underline bg-red-600 hover:bg-red-500 text-white shadow-lg shadow-red-500/25 hover:shadow-red-500/40 transition-all"
        >
          {t('page.home.ctaTools')}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
          </svg>
        </a>
        <a
          href={`${base}${t('nav.href.categories')}`}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-medium no-underline hover:no-underline border border-red-500/50 text-red-400 hover:bg-red-500/10 transition-all"
        >
          {t('page.home.ctaCategories')}
        </a>
      </div>

      <!-- Stats -->
      <div class="flex flex-wrap items-center justify-center gap-4 animate-fade-in-up" style="animation-delay: 0.3s">
        <span class="px-4 py-2 rounded-full text-sm font-medium" style="background: var(--color-bg-secondary); border: 1px solid var(--color-border); color: var(--color-text-secondary)">
          {tf('page.home.statTools', { tools: totalTools })}
        </span>
        <span class="px-4 py-2 rounded-full text-sm font-medium" style="background: var(--color-bg-secondary); border: 1px solid var(--color-border); color: var(--color-text-secondary)">
          {tf('page.home.statCategories', { categories: totalCategories })}
        </span>
        <span class="px-4 py-2 rounded-full text-sm font-medium" style="background: var(--color-bg-secondary); border: 1px solid var(--color-border); color: var(--color-text-secondary)">
          {tf('page.home.statLicenses', { licenses: uniqueLicenses })}
        </span>
      </div>
    </div>
  </section>

  <!-- Random Tools -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold mb-3" style="color: var(--color-text-primary)">
        {t('page.home.toolsHeadingLead')}<span class="gradient-text">{t('page.home.toolsHeadingAccent')}</span>
      </h2>
      <p style="color: var(--color-text-secondary)">
        {t('page.home.toolsSubtitle')}
      </p>
    </div>
    <div id="random-tools-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 stagger-fade">
      {toolPool.map((tool, i) => (
        <div class="random-tool-item" data-index={i} style={i >= VISIBLE_COUNT ? 'display:none' : ''}>
          <ToolCard tool={tool} />
        </div>
      ))}
    </div>
    <div class="text-center mt-8">
      <a
        href={`${base}${t('nav.href.tools')}`}
        class="inline-flex items-center gap-2 text-sm font-medium text-red-400 hover:text-red-300 no-underline hover:no-underline"
      >
        {tf('page.home.viewAllTools', { tools: totalTools })}
      </a>
    </div>
  </section>

  <!-- Random Categories -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20" style="border-top: 1px solid var(--color-border)">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold mb-3" style="color: var(--color-text-primary)">
        {t('page.home.categoriesHeadingLead')}<span class="gradient-text">{t('page.home.categoriesHeadingAccent')}</span>
      </h2>
      <p style="color: var(--color-text-secondary)">
        {tf('page.home.categoriesSubtitle', { categories: totalCategories })}
      </p>
    </div>
    <div id="random-categories-grid" class="grid grid-cols-2 md:grid-cols-3 gap-4 stagger-fade">
      {categoryPool.map((cat, i) => (
        <div class="random-category-item" data-index={i} style={i >= VISIBLE_COUNT ? 'display:none' : ''}>
          <CategoryCard category={cat} />
        </div>
      ))}
    </div>
    <div class="text-center mt-8">
      <a
        href={`${base}${t('nav.href.categories')}`}
        class="inline-flex items-center gap-2 text-sm font-medium text-red-400 hover:text-red-300 no-underline hover:no-underline"
      >
        {t('page.home.viewAllCategories')}
      </a>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="card p-8 md:p-12 text-center" style="border-color: var(--color-border-accent)">
      <h2 class="text-2xl md:text-3xl font-bold mb-4" style="color: var(--color-text-primary)">
        {t('page.home.finalHeading')}
      </h2>
      <p class="text-lg mb-8 max-w-2xl mx-auto" style="color: var(--color-text-secondary)">
        {tf('page.home.finalBody', { tools: totalTools })}
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={`${base}${t('nav.href.comparison')}`}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-medium no-underline hover:no-underline bg-red-600 hover:bg-red-500 text-white transition-all"
        >
          {t('page.home.finalCompare')}
        </a>
        <a
          href={`${base}${t('nav.href.guides')}`}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-medium no-underline hover:no-underline border border-red-500/50 text-red-400 hover:bg-red-500/10 transition-all"
        >
          {t('page.home.finalSelfHost')}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function showRandom(containerSelector: string, itemSelector: string, count: number) {
    const items = Array.from(document.querySelectorAll(containerSelector + ' ' + itemSelector)) as HTMLElement[];
    items.forEach(el => { el.style.display = 'none'; });
    for (let i = items.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [items[i], items[j]] = [items[j], items[i]];
    }
    items.slice(0, count).forEach(el => { el.style.display = ''; });
  }
  showRandom('#random-tools-grid', '.random-tool-item', 6);
  showRandom('#random-categories-grid', '.random-category-item', 6);
</script>
