---
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import SearchModal from '../../../components/ui/SearchModal.astro';
import ToolDetail from '../../../components/tools/ToolDetail.astro';
import { allTools } from '../../../data/tools/index';
import { categories } from '../../../data/categories';
import { breadcrumbJsonLd, categoryNamesFor, toolJsonLd } from '../../../utils/structured-data';
import { languages } from '../../../i18n/ui';
import { getLangFromUrl, useTranslations, getHomeHref, getCategoryName } from '../../../i18n/utils';

export function getStaticPaths() {
  return Object.keys(languages).flatMap(lang =>
    allTools.map(tool => ({ params: { lang, slug: tool.slug } }))
  );
}

const { slug } = Astro.params;
const base = import.meta.env.BASE_URL;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const tool = allTools.find((entry) => entry.slug === slug);

if (!tool) {
  return Astro.redirect(`${base}${t('nav.href.tools')}`);
}

// `description` still holds German for the 270 curated tools; the page body
// already prefers descriptionEn, and the meta tags must not disagree.
const metaDescription = tool.descriptionEn ?? tool.description;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = [
  toolJsonLd(tool, {
    url: pageUrl,
    lang,
    categoryNames: categoryNamesFor(tool, categories, catSlug => getCategoryName(catSlug, lang)),
  }),
  breadcrumbJsonLd([
    { name: 'SafeCh', url: new URL(getHomeHref(lang), Astro.site).href },
    { name: t('nav.tools'), url: new URL(`${base}${t('nav.href.tools')}`, Astro.site).href },
    { name: tool.name, url: pageUrl },
  ]),
];
---

<BaseLayout title={`${tool.name} – SafeCh`} description={metaDescription} jsonLd={jsonLd}>
  <SearchModal />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-16">
    <ToolDetail tool={tool} allTools={allTools} categories={categories} />
  </div>
</BaseLayout>
