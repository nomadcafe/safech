---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import SearchModal from '../../components/ui/SearchModal.astro';
import { localePaths } from '../../i18n/paths';
import { getLangFromUrl } from '../../i18n/utils';
import { licenseBadges, licenseOverviewContent } from '../../i18n/content/license-overview';

export const getStaticPaths = localePaths;

const page = licenseOverviewContent[getLangFromUrl(Astro.url)];
const columnColors = ['text-green-400', 'text-yellow-400', 'text-red-400'];
---

<BaseLayout title={page.title} description={page.description}>
  <SearchModal />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-16">
    <h1 class="text-4xl font-bold mb-4" style="color: var(--color-text-primary)" set:html={page.heading} />
    <p class="text-lg mb-12" style="color: var(--color-text-secondary)" set:html={page.subtitle} />

    <div class="space-y-6">
      {page.licenses.map((license, i) => (
        <div class="card p-6">
          <div class="flex items-center gap-3 mb-3">
            <span class:list={['badge', licenseBadges[i].badgeClass]}>{licenseBadges[i].badge}</span>
            <h2 class="text-lg font-semibold" style="color: var(--color-text-primary)">{license.name}</h2>
          </div>
          <p class="text-sm mb-3" style="color: var(--color-text-secondary)">{license.summary}</p>
          <div class="grid grid-cols-3 gap-4 text-xs">
            {license.columns.map((value, col) => (
              <div>
                <strong class={columnColors[col]}>{page.columnLabels[col]}</strong><br/>
                <span style="color: var(--color-text-muted)">{value}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
