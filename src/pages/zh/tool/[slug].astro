---
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import SearchModal from '../../../components/ui/SearchModal.astro';
import ToolDetail from '../../../components/tools/ToolDetail.astro';
import { allTools } from '../../../data/tools/index';
import { categories } from '../../../data/categories';
import { getCategoryName } from '../../../i18n/utils';
import { breadcrumbJsonLd, categoryNamesFor, toolJsonLd } from '../../../utils/structured-data';

export function getStaticPaths() {
  return allTools.map((tool) => ({
    params: { slug: tool.slug },
  }));
}

const { slug } = Astro.params;
const base = import.meta.env.BASE_URL;
const tool = allTools.find((t) => t.slug === slug);

if (!tool) {
  return Astro.redirect(`${base}zh/tools/`);
}

// `description` still holds German for the 270 curated tools; the page body
// already prefers descriptionEn, and the meta tags must not disagree.
const metaDescription = tool.descriptionEn ?? tool.description;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = [
  toolJsonLd(tool, {
    url: pageUrl,
    lang: 'zh',
    categoryNames: categoryNamesFor(tool, categories, catSlug => getCategoryName(catSlug, 'zh')),
  }),
  breadcrumbJsonLd([
    { name: 'SafeCh', url: new URL(`${base}zh/`, Astro.site).href },
    { name: '工具', url: new URL(`${base}zh/tools/`, Astro.site).href },
    { name: tool.name, url: pageUrl },
  ]),
];
---

<BaseLayout title={`${tool.name} – SafeCh`} description={metaDescription} jsonLd={jsonLd}>
  <SearchModal />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-16">
    <ToolDetail tool={tool} allTools={allTools} categories={categories} />
  </div>
</BaseLayout>
